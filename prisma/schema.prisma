
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
  role      Role     @relation(fields: [roleId], references: [id])
}

model Permission {
  id    String           @id @default(cuid())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}


model Comment {
  id          String        @id @default(cuid())
  postId      String
  parentId    String?
  authorName  String
  authorEmail String
  content     String
  status      CommentStatus @default(PENDING)
  isAdmin     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([postId, status])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}


model Service {
  id           String               @id @default(cuid())
  icon         String?
  isActive     Boolean              @default(true)
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  images       ServiceImage[]
  translations ServiceTranslation[]
}

model ServiceTranslation {
  id          String   @id @default(cuid())
  serviceId   String
  languageId  String
  title       String
  slug        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  language    Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, languageId])
  @@unique([slug, languageId])
  @@index([serviceId])
  @@index([languageId])
}

model ServiceImage {
  id        String  @id @default(cuid())
  serviceId String
  mediaId   String
  order     Int     @default(0)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, mediaId])
  @@index([serviceId])
  @@index([mediaId])
}

model Post {
  id            String            @id @default(cuid())
  authorId      String
  thumbnailId   String?
  status        PostStatus        @default(DRAFT)
  publishedAt   DateTime?
  isFeatured    Boolean           @default(false)
  viewCount     Int               @default(0)
  readingTime   Int               @default(0)
  allowComments Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  author        User              @relation(fields: [authorId], references: [id])
  thumbnail     Media?            @relation("PostThumbnail", fields: [thumbnailId], references: [id])

  categories    PostToCategory[]
  tags          PostToTag[]
  translations  PostTranslation[]
  featuredMedia BlogPostMedia[]
  comments      Comment[]

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
  @@index([thumbnailId])
  @@index([status, publishedAt])
}

model BlogPostMedia {
  id        String   @id @default(cuid())
  postId    String
  mediaId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([postId])
  @@index([mediaId])
}

model PostTranslation {
  id              String   @id @default(cuid())
  postId          String
  languageId      String
  title           String
  slug            String
  excerpt         String?
  content         String
  metaTitle       String?
  metaDescription String?
  keywords        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  language        Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, languageId])
  @@unique([slug, languageId])
  @@index([slug])
  @@index([postId])
  @@index([languageId])
}


enum MediaType {
  IMAGE
  FILE
  VIDEO
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactStatus {
  UNREAD
  READ
}


model Faq {
  id           String           @id @default(cuid())
  categoryId   String?
  isFeatured   Boolean          @default(false)
  isActive     Boolean          @default(true)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  category     FaqCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations FaqTranslation[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([order])
}

model FaqTranslation {
  id         String    @id @default(cuid())
  faqId      String
  languageId String
  question   String
  answer     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  faq        Faq       @relation(fields: [faqId], references: [id], onDelete: Cascade)
  language   Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([faqId, languageId])
  @@index([faqId])
  @@index([languageId])
}

model FaqCategory {
  id           String           @id @default(cuid())
  slug         String           @unique
  isActive     Boolean          @default(true)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  faqs         Faq[]
  translations FaqCategoryTranslation[]

  @@index([isActive])
  @@index([order])
}

model FaqCategoryTranslation {
  id            String       @id @default(cuid())
  categoryId    String
  languageId    String
  name          String
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category      FaqCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language      Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@index([categoryId])
  @@index([languageId])
}


model Hero {
  id              String   @id @default(cuid())
  type            String   @default("STATIC") // STATIC | SLIDER | VIDEO
  imageId         String?
  videoUrl        String?
  ctaPrimaryUrl   String?
  ctaSecondaryUrl String?
  overlayOpacity  Int      @default(40)
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  image        Media?            @relation("HeroImage", fields: [imageId], references: [id], onDelete: SetNull)
  images       HeroImage[]
  translations HeroTranslation[]

  @@index([isActive, order])
}

model HeroImage {
  id      String @id @default(cuid())
  heroId  String
  mediaId String
  order   Int    @default(0)

  hero  Hero  @relation(fields: [heroId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([heroId, mediaId])
  @@index([heroId])
  @@index([mediaId])
}

model HeroTranslation {
  id             String   @id @default(cuid())
  heroId         String
  languageId     String
  title          String
  subtitle       String?
  description    String?
  ctaPrimaryText String?
  ctaSecondaryText String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hero     Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([heroId, languageId])
  @@index([heroId])
  @@index([languageId])
}


model Media {
  id           String    @id @default(cuid())
  name         String
  url          String
  type         MediaType
  mimeType     String?
  size         Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  thumbnailPosts Post[]         @relation("PostThumbnail")
  blogPosts      BlogPostMedia[]
  services       ServiceImage[]
  testimonials Testimonial[]
  portfolioCovers   Portfolio[]        @relation("PortfolioCover")
  portfolioGallery  PortfolioGallery[] @relation("PortfolioGalleryMedia")
  heroes            Hero[]             @relation("HeroImage")
  heroImages        HeroImage[]

}


model Page {
  id          String     @id @default(cuid())
  slug        String     @unique
  status      PostStatus @default(DRAFT)
  isHomePage  Boolean    @default(false)
  template    String?    @default("default")
  publishedAt DateTime?
  canonicalUrl String?
  ogImage      String?
  structuredData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageTranslation[]
  sections     PageSection[]

  @@index([status])
  @@index([slug, status])
}

model PageTranslation {
  id         String @id @default(cuid())
  pageId     String
  languageId String

  title           String
  excerpt         String?
  content         String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonicalUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([pageId, languageId])
  @@index([languageId])
}

model PageSection {
  id       String  @id @default(cuid())
  pageId   String
  type     String
  order    Int     @default(0)
  isActive Boolean @default(true)
  content  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([type])
}


model Portfolio {
  id             String                   @id @default(cuid())
  slug           String                   @unique
  clientName     String?
  industry       String?
  location       String?
  completedAt    DateTime?
  coverImageId   String?
  isFeatured     Boolean                  @default(false)
  isActive       Boolean                  @default(true)
  order          Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  coverImage     Media?                   @relation("PortfolioCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  translations   PortfolioTranslation[]
  galleries      PortfolioGallery[]
  tags           PortfolioTagMap[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([order])
}

model PortfolioTranslation {
  id             String        @id @default(cuid())
  portfolioId    String
  languageId     String
  title          String
  excerpt        String?
  description    String
  result         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  portfolio      Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  language       Language      @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, languageId])
  @@index([portfolioId])
  @@index([languageId])
}

model PortfolioGallery {
  id             String        @id @default(cuid())
  portfolioId    String
  mediaId        String
  order          Int           @default(0)

  portfolio      Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  media          Media         @relation("PortfolioGalleryMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([mediaId])
}

model PortfolioTag {
  id             String                   @id @default(cuid())
  slug           String                   @unique
  isActive       Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  translations   PortfolioTagTranslation[]
  portfolios     PortfolioTagMap[]

  @@index([isActive])
}

model PortfolioTagTranslation {
  id             String        @id @default(cuid())
  tagId          String
  languageId     String
  name           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tag            PortfolioTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  language       Language      @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([tagId, languageId])
  @@index([tagId])
  @@index([languageId])
}

model PortfolioTagMap {
  portfolioId    String
  tagId          String

  portfolio      Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  tag            PortfolioTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([portfolioId, tagId])
}


model Seo {
  id                 String   @id @default(cuid())
  siteName           String?
  siteUrl            String?
  siteLogo           String?
  title              String?
  description        String?
  keywords           String?
  robots             String?
  canonicalUrl       String?
  locale             String?  @default("id_ID")
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  ogType             String?  @default("website")
  twitterCard        String?  @default("summary_large_image")
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
  twitterSite        String?
  structuredData     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}


model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}


model Language {
  id                       String                    @id @default(cuid())
  code                     String                    @unique
  name                     String
  nativeName               String
  isDefault                Boolean                   @default(false)
  isActive                 Boolean                   @default(true)
  order                    Int                       @default(0)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  postCategoryTranslations PostCategoryTranslation[]
  postTagTranslations      PostTagTranslation[]
  postTranslations         PostTranslation[]
  translations             ServiceTranslation[]
  testimonialTranslations  TestimonialTranslation[]
  faqTranslations          FaqTranslation[]
  faqCategoryTranslations  FaqCategoryTranslation[]
  portfolioTranslations      PortfolioTranslation[]
  portfolioTagTranslations   PortfolioTagTranslation[]
  pageTranslations         PageTranslation[]
  heroTranslations         HeroTranslation[]
}

model PostCategory {
  id           String                    @id @default(cuid())
  icon         String?
  isActive     Boolean                   @default(true)
  order        Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  translations PostCategoryTranslation[]
  posts        PostToCategory[]
}

model PostCategoryTranslation {
  id          String       @id @default(cuid())
  categoryId  String
  languageId  String
  name        String
  slug        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language    Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@unique([slug, languageId])
  @@index([categoryId])
  @@index([languageId])
}

model PostTag {
  id           String               @id @default(cuid())
  isActive     Boolean              @default(true)
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations PostTagTranslation[]
  posts        PostToTag[]
}

model PostTagTranslation {
  id         String   @id @default(cuid())
  tagId      String
  languageId String
  name       String
  slug       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  tag        PostTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, languageId])
  @@unique([slug, languageId])
  @@index([tagId])
  @@index([languageId])
}

model PostToCategory {
  id         String       @id @default(cuid())
  postId     String
  categoryId String
  category   PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
  @@index([postId])
  @@index([categoryId])
}

model PostToTag {
  id     String  @id @default(cuid())
  postId String
  tagId  String
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])

}


model Testimonial {
  id           String                   @id @default(cuid())
  clientName   String
  clientRole   String?
  companyName  String?
  companyUrl   String?
  projectName  String?
  rating       Int                      @default(5)
  avatarId     String?
  isFeatured   Boolean                  @default(false)
  isActive     Boolean                  @default(true)
  order        Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  avatar       Media?                   @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  translations TestimonialTranslation[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([order])
}

model TestimonialTranslation {
  id            String       @id @default(cuid())
  testimonialId String
  languageId    String
  content       String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  testimonial   Testimonial  @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  language      Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([testimonialId, languageId])
  @@index([testimonialId])
  @@index([languageId])
}

